{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": ["css/**", "js/**", "index.html", "server.js", "db.js", "auth.js", "routes.js"]
      }
    }
  ],
  "routes": [
    { "src": "/(css|js)/(.*)", "dest": "server.js" },
    { "src": "/(.*)", "dest": "server.js" }
  ]
}
